# KOSH-PRAMAAN Backend Environment Configuration
PORT=5001
NODE_ENV=development

# Authentication & Cryptographic Security
# In production, JWT_SECRET is MANDATORY and must be at least 32 characters (256 bits).
JWT_SECRET=your_32_char_minimum_cryptographic_secret_here!

# Demo Authentication Control
# In production, demo endpoints are DISABLED by default. Set to true to permit supervised evaluation.
ENABLE_DEMO_AUTH=true

# Database Persistence (PostgreSQL)
# For cloud deployments (e.g. Neon, Supabase, RDS, Railway), specify DATABASE_URL.
DATABASE_URL=postgresql://user:password@host:5432/kosh_pramaan?sslmode=require

# SSL Configuration
# Default is strict certificate verification (rejectUnauthorized: true).
# Set to true ONLY if your database uses self-signed certificates.
PG_SSL_ALLOW_SELF_SIGNED=false

# Persistence Enforcement
# When true, all mutation failures return HTTP 503 instead of in-memory fallback.
STRICT_PERSISTENCE=false

# Granular PostgreSQL fallback (used only if DATABASE_URL is not set)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_secure_password_here
PGDATABASE=postgres
