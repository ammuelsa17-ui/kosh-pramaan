{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "kosh-backend": {
      "root": "kosh-backend",
      "framework": "express"
    },
    "kosh-frontend": {
      "root": "kosh-frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "kosh-backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "kosh-frontend" }
    }
  ]
}
