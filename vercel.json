{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "kosh_frontend": {
      "root": "kosh-frontend/"
    },
    "kosh_backend": {
      "root": "kosh-backend/"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "kosh_backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "kosh_frontend" }
    }
  ]
}
